{
  "version": 2,
  "builds": [
    {
      "src": "laptop-server/server.js",
      "use": "@vercel/node"
    },
    {
      "src": "dashboard/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "laptop-server/server.js"
    },
    {
      "src": "/upload",
      "dest": "laptop-server/server.js"
    },
    {
      "src": "/frames/(.*)",
      "dest": "laptop-server/server.js"
    },
    {
      "src": "/",
      "dest": "dashboard/index.html"
    },
    {
      "src": "/dashboard",
      "dest": "dashboard/index.html"
    },
    {
      "src": "/dashboard/",
      "dest": "dashboard/index.html"
    },
    {
      "src": "/(.*\\.(html|css|js|json|png|jpg|gif|ico|svg|woff|woff2|ttf))",
      "dest": "dashboard/$1"
    },
    {
      "src": "/(.*)",
      "dest": "dashboard/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*\\.html)",
      "headers": [
        { "key": "Content-Type", "value": "text/html; charset=utf-8" }
      ]
    },
    {
      "source": "/(.*\\.js)",
      "headers": [
        { "key": "Content-Type", "value": "application/javascript; charset=utf-8" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Content-Type", "value": "application/json; charset=utf-8" }
      ]
    }
  ]
}
